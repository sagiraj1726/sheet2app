# Copy to .env and adjust. Never commit .env.
PORT=3000
# Bind to localhost only. Put a TLS-terminating reverse proxy in front for public use.
HOST=127.0.0.1
NODE_ENV=development

# Upload limits
MAX_UPLOAD_MB=10
MAX_SHEETS=30
MAX_ROWS_PER_SHEET=50000

# Workspace lifetime (hours) and cleanup interval (minutes)
WORKSPACE_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# Set true only when running behind a trusted HTTPS reverse proxy (enables Secure cookies)
TRUST_PROXY=false
COOKIE_SECURE=false

# Plan applied to this deployment: free | pro | business
# (No payments are processed. See src/config/plans.js)
PLAN=free

# Optional billing provider integration point (leave blank - not implemented)
BILLING_PROVIDER=
BILLING_CHECKOUT_URL=
